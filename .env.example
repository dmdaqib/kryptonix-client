# ─────────────────────────────────────────────────────────────
# KryptonIX Client — Environment Configuration Template
# Copy to apps/api/.env and fill in real values.
# NEVER commit a real .env file. NEVER put secrets in mobile app code.
# ─────────────────────────────────────────────────────────────

# --- App ---
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
APP_NAME=KryptonIX Client
CLIENT_WEB_URL=https://kryptonix.digital

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kryptonix_client?schema=public

# --- Auth / Sessions ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_SALT_ROUNDS=12

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000

# --- Email (transactional) ---
EMAIL_PROVIDER=console
EMAIL_FROM="KryptonIX <no-reply@kryptonix.digital>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- File / Object storage ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
SIGNED_URL_TTL_SECONDS=300

# --- Push notifications ---
EXPO_ACCESS_TOKEN=

# --- Payment gateway (provider-independent layer, see PAYMENTS.md) ---
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR

# --- Observability ---
LOG_LEVEL=info
SENTRY_DSN=
