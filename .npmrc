
# React Native / Expo's tooling assumes a flatter node_modules layout than
# pnpm's default strict symlinked one — without this, various packages that
# are only *transitive* dependencies (@expo/cli, @expo/metro-runtime,
# @react-native/debugger-frontend, @expo/vector-icons, etc.) fail to resolve
# at runtime with "Cannot find module", even though they're technically
# present in the pnpm store. This is Expo's own documented recommendation
# for pnpm monorepos. After pulling this change, delete node_modules
# everywhere and run `pnpm install` again for it to take effect.
node-linker=hoisted
